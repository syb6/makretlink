{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "composer install --no-dev --no-interaction --prefer-dist --no-progress --optimize-autoloader && npm run build"
    },
    "deploy": {
        "preDeployCommand": "php artisan migrate --force && php artisan storage:link && php artisan optimize",
        "startCommand": "php artisan serve --host=0.0.0.0 --port=$PORT",
        "healthcheckPath": "/up",
        "healthcheckTimeout": 120,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}
