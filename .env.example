APP_NAME=MarketLink
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Railway structured logging (recommended on Railway):
LOG_CHANNEL=stderr
# LOG_STDERR_FORMATTER=\Monolog\Formatter\JsonFormatter

# ---------------------------------------------------------------------
# Database — local default is SQLite; on Railway use the MySQL service:
#   DB_CONNECTION=mysql
#   DB_URL=${{MySQL.DATABASE_URL}}
# ---------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Resend (transactional email) ---
# Get a key at https://resend.com/api-keys. Leave empty to fall back to the
# log transport (emails are written to the log instead of sent).
# MAIL_FROM_ADDRESS must be a sender on your Resend-verified domain for real delivery.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Groq AI Assistant (chatbot) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_ENABLED=true
